---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ '/' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/en/' | absolute_url }}"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/en/' | absolute_url }}</loc>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ '/' | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ '/en/' | absolute_url }}"/>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {% if post.translation_url %}
    {% if post.lang == 'en' %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ post.url | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ post.translation_url | absolute_url }}"/>
    {% else %}
    <xhtml:link rel="alternate" hreflang="fa" href="{{ post.url | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ post.translation_url | absolute_url }}"/>
    {% endif %}
    {% endif %}
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
</urlset>
